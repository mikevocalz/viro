{
  "name": "@reactvision/react-viro",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "version": "3.1.0-moyo.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ReactVision/viro.git"
  },
  "description": "Maintained version of react-viro - New Architecture (Fabric) required",
  "scripts": {
    "start": "echo 'I dont think you meant to run npm start here.'",
    "test": "jest",
    "tsc": "tsc && tsc -p tsconfig.plugins.json",
    "harness": "vite",
    "prebuild": "node -p \"'export const VIRO_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > components/Utilities/ViroVersion.ts",
    "build": "tsc && tsc -p tsconfig.plugins.json && npm run build:specs-cli && npm run copy-files",
    "build:specs-cli": "tsc -p tsconfig.specs-cli.json",
    "build:specs-core": "npm run build:specs-cli",
    "bundle": "./prepare_release.sh",
    "copy-files": "cp -r ./components/Resources/ ./dist/components/Resources/",
    "clean": "rm -rf ./dist/ *.tgz node_modules/",
    "release": "release-it",
    "after:release": "./prepare_release.sh",
    "prepare": "npm run build",
    "harness:assets": "bash scripts/sync-harness-assets.sh",
    "preharness": "npm run harness:assets",
    "audit:events": "node scripts/audit-events.cjs",
    "test:specs-compiler": "npm run build:specs-cli && node scripts/test-viro-specs-compiler.cjs",
    "test:specs": "jest --runInBand --config jest.specs.config.cjs __test__/ViroSpecs",
    "fixtures:specs-actions": "SPECS_UPDATE_FIXTURES=1 jest --runInBand --config jest.specs.config.cjs __test__/ViroSpecsActions -t fixtures",
    "test:rive-contract": "node scripts/test-rive-local-contract.cjs",
    "perf:tracesift:init": "npx --yes @callstack/tracesift@0.3.1 init",
    "perf:tracesift": "npx --yes @callstack/tracesift@0.3.1 start",
    "test:plugin-load": "node scripts/check-plugin-loads.cjs",
    "check:ios-bridge": "bash scripts/check-ios-bridge.sh",
    "test:specs-consumer": "node scripts/check-specs-consumer.cjs",
    "typecheck:specs-examples": "tsc -p tsconfig.specs-examples.json",
    "test:specs-api": "node scripts/specs-api-snapshot.cjs",
    "docs:specs-errors": "node scripts/specs-error-reference.cjs"
  },
  "peerDependencies": {
    "@reactvision/react-native-visionos": ">=0.86.0 <0.89.0",
    "@reactvision/viro-web-renderer": "^1.0.1",
    "expo": ">=58.0.0 <59.0.0",
    "react": "^19.3.0",
    "react-native": ">=0.88.0 <0.89.0",
    "react-native-web": "^0.21.0",
    "@metavr/layout-compat": "^1.0.0",
    "@metavr/layout-window-compat": "^1.0.0",
    "@viro-external/specs": "^0.3.0"
  },
  "engines": {
    "react-native": ">=0.88.0 <0.89.0"
  },
  "peerDependenciesMeta": {
    "@reactvision/react-native-visionos": {
      "optional": true
    },
    "@reactvision/viro-web-renderer": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    },
    "@metavr/layout-compat": {
      "optional": true
    },
    "@metavr/layout-window-compat": {
      "optional": true
    },
    "@viro-external/specs": {
      "optional": true
    }
  },
  "files": [
    "index.d.ts",
    "index.js",
    "index.ts",
    "components",
    "dist",
    "plugins",
    "patches",
    "shims",
    "scripts",
    "!scripts/specs-lens",
    "!scripts/specs-lens-setup.mjs",
    "examples",
    "!examples/specs-platform-lab/lens",
    "web/renderer",
    "app.plugin.js",
    "android/react_viro",
    "android/viro_renderer",
    "android/gvr_common",
    "android/arcore_client",
    "android/one-launcher-tile.gradle",
    "ios/dist",
    "ios/ViroReact",
    "ios/*.h",
    "ios/*.m",
    "ios/*.mm",
    "ios/ViroReact.podspec",
    "ios/PrivacyInfo.xcprivacy",
    "ios/ViroReactUI.podspec",
    "ios/ViroReactExternalVideo.podspec",
    "bin",
    "schemas",
    "LICENSE"
  ],
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/standalone": "^8.0.9",
    "@expo/config-plugins": "~58.0.10",
    "@jest/globals": "^30.5.2",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/eslint-config": "^0.88.0",
    "@react-native/metro-config": "^0.88.0",
    "@react-native/typescript-config": "^0.88.0",
    "@reactvision/viro-web-renderer": "^1.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "8.20.0",
    "babel-jest": "^30.5.2",
    "expo": "~58.0.19",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "~0.88.0",
    "react-native-web": "^0.21.4",
    "react-test-renderer": "19.3.1",
    "release-it": "^21.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "bugs": {
    "url": "https://github.com/ReactVision/viro/issues"
  },
  "homepage": "https://reactvision.xyz/viro-react",
  "author": "ReactVision, Inc",
  "dependencies": {
    "zustand": "5.0.16",
    "@babel/parser": "^8.0.8"
  },
  "bin": {
    "viro-specs": "bin/viro-specs.cjs",
    "viro-specs-compile": "bin/viro-specs-compile.cjs"
  }
}
