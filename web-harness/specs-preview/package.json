{
  "name": "@reactvision/viro-specs-preview",
  "private": true,
  "version": "0.1.0",
  "description": "three.js preview of Viro Specs manifests with Lens host parity semantics.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "screenshot": "node scripts/screenshot.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "storybook:screenshots": "node scripts/storybook-screenshots.mjs",
    "vendor:check": "node scripts/sync-lens-core.mjs --check",
    "vendor:sync": "node scripts/sync-lens-core.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@storybook/html-vite": "10.6.5",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "playwright": "1.64.1",
    "storybook": "10.6.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
